{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "muasuites",
    "compatibility_date": "2026-05-29",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
      "binding": "ASSETS",
      "directory": ".svelte-kit/cloudflare"
    },
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "kv_namespaces": [
      {
        "binding": "MUA_CACHE",
        "id": "mua-cache"
      }
    ]
  }
