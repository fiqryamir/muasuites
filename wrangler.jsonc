{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "muasuites",
	"compatibility_date": "2026-05-29",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
  "observability": {
    "enabled": true
  },
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "MUA_CACHE",
			"id": "aea3acba8cde4bafa770fd720769c8af",
			"remote": false
		}
	]
	// redeploy-trigger: no-op comment to force a Git-integration rebuild/deploy
}
